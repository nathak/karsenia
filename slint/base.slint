// What every part of the window shares: the Stitch colours, the words, and the small pieces (pill, button, styled text).
// Colours of the dark and the light look; `mode` is 0 dark, 1 light, 2 follow the system (read once when the window starts).
export global Theme {
    in-out property <int> mode: 0;
    in-out property <bool> sys-dark: true;
    out property <bool> dark: root.mode == 0 || (root.mode == 2 && root.sys-dark);
    out property <color> surface: root.dark ? #121614 : #f6f7f2;
    out property <color> lowest: root.dark ? #0e1210 : #ffffff;
    out property <color> low: root.dark ? #171c1a : #eef1ea;
    out property <color> container: root.dark ? #1b221e : #e8ece3;
    out property <color> high: root.dark ? #242c27 : #dfe4d9;
    out property <color> highest: root.dark ? #2e3731 : #d5dbce;
    out property <color> hairline: root.dark ? #2c3630 : #c9d0c2;
    out property <color> outline: root.dark ? #85918a : #6c766d;
    out property <color> on-surface: root.dark ? #e3e8e1 : #1a1f1b;
    out property <color> on-var: root.dark ? #bcc6be : #48514a;
    // The brand: the moss green of the icon (selection, buttons, toggles, progress, links).
    out property <color> primary: root.dark ? #a5b649 : #5f7a1f;
    out property <color> primary-soft: root.dark ? #c4d160 : #4e6619;
    out property <color> on-primary: root.dark ? #141a0b : #ffffff;
    // Attention (a warning, a limit, a notice, a held call): the orange of the icon, never the brand green.
    out property <color> warn: root.dark ? #dc825a : #b4532a;
    out property <color> warn-soft: root.dark ? #f0a283 : #9a4421;
    out property <color> on-warn: root.dark ? #1b0f0a : #ffffff;
    out property <color> ok: root.dark ? #8fdcaa : #267a4b;
    out property <color> error: root.dark ? #f2796f : #c4372c;
    out property <color> info: root.dark ? #a6c9f8 : #295fae;
    out property <color> violet: root.dark ? #857bed : #5a4fd0;
    in property <string> mono: "JetBrains Mono";
}

// The fixed words of the window, filled from src/view/i18n.rs.
export global T {
    in property <string> app-sub; in property <string> tab-chats; in property <string> tab-memory; in property <string> tab-skills;
    in property <string> tab-sched; in property <string> tab-files; in property <string> sessions; in property <string> new-chat;
    in property <string> folder; in property <string> model; in property <string> create; in property <string> cancel;
    in property <string> empty; in property <string> placeholder; in property <string> send; in property <string> stop;
    in property <string> hint; in property <string> copy; in property <string> perm-title; in property <string> deny-reason;
    in property <string> deny; in property <string> allow-once; in property <string> allow-chat; in property <string> perm-suggest;
    in property <string> perm-blocked; in property <string> connected; in property <string> new-intro; in property <string> folder-ph; in property <string> start; in property <string> phase-note; in property <string> pwd;
    in property <string> zoom;
    // Every newer word: `T.tr(<key>)` reads src/view/i18n.rs through Rust, so a new word needs no property here.
    pure callback tr(string) -> string;
}

export component Pill inherits Rectangle {
    in property <string> text;
    in property <color> fg: Theme.outline;
    in property <color> fill: transparent;
    in property <bool> pulse: false;
    in property <image> icon;
    in property <bool> show-icon: false;
    // A pill that opens something: the pointer says so.
    in property <bool> clickable: false;
    callback clicked;
    height: 22px;
    border-radius: 11px;
    border-width: 1px;
    border-color: fg.with-alpha(0.45);
    background: fill;
    HorizontalLayout {
        padding-left: 9px; padding-right: 9px; spacing: 6px; alignment: center;
        if pulse: Rectangle { width: 6px; height: 6px; y: (parent.height - self.height) / 2; border-radius: 3px; background: Theme.primary; }
        if show-icon: Image { source: root.icon; width: 12px; height: 12px; y: (parent.height - 12px) / 2; colorize: root.fg; }
        Text { text: root.text; color: root.fg; font-size: 11px; font-weight: 600; font-family: Theme.mono; vertical-alignment: center; }
    }
    if root.clickable: TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

export component Btn inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> show-icon: false;
    in property <bool> primary: false;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    // A text longer than this is cut with "…" (the caller shows the whole of it when the pointer is over the button).
    in property <length> max-text: 100000px;
    out property <bool> hover: area.has-hover;
    callback clicked;
    callback hovered(bool);
    changed hover => { root.hovered(root.hover); }
    height: 30px;
    min-width: min(label.preferred-width, root.max-text) + 24px + (show-icon ? 22px : 0px);
    preferred-width: self.min-width;
    border-radius: 8px;
    border-width: 1px;
    border-color: primary ? Theme.primary : danger ? Theme.error : Theme.hairline;
    background: !enabled ? Theme.high.with-alpha(0.5) : primary ? (area.has-hover ? Theme.primary.brighter(0.08) : Theme.primary) : danger ? transparent : (area.has-hover ? Theme.highest : Theme.high);
    opacity: enabled ? 1 : 0.5;
    HorizontalLayout {
        alignment: center; spacing: 8px;
        label := Text { text: root.text; color: !enabled ? Theme.on-var : primary ? Theme.on-primary : danger ? Theme.error : Theme.on-surface; font-size: 13px; font-weight: primary ? 600 : 400; vertical-alignment: center; overflow: elide; }
        if show-icon: Image { source: root.icon; width: 14px; height: 14px; y: (parent.height - 14px) / 2; colorize: !enabled ? Theme.on-var : primary ? Theme.on-primary : Theme.on-surface; }
    }
    area := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// Styled text whose height is measured by the same text, plain and bold, wrapped at the same width: the styled element alone is
// given a one-line height inside the transcript rows, and bold is the widest the styled text can be.
export component Rich inherits Rectangle {
    in property <styled-text> rich;
    // The same words as plain text: measured (hidden) so that the height follows the wrapping.
    in property <string> plain;
    in property <length> size;
    in property <color> fg;
    callback link(string);
    height: measure.preferred-height;
    measure := Text { width: parent.width; text: root.plain; wrap: word-wrap; font-size: root.size; font-weight: 600; opacity: 0; }
    // A drag selects (also where the text is bold, code or holds a link), a double click selects a word, a triple click the paragraph, and
    // Ctrl+C copies; a click that does not drag still follows a link. A selection stays inside one paragraph (Slint 1.19).
    StyledText {
        width: parent.width; height: parent.height; text: root.rich; default-color: root.fg; default-font-size: root.size; link-color: Theme.primary-soft;
        selectable: true; selection-background-color: Theme.primary.with-alpha(0.4); selection-foreground-color: root.fg;
        link-clicked(url) => { root.link(url); }
    }
}

// Selectable text whose height follows its wrapping: the layout around a read-only TextInput gave it the height of its
// unwrapped lines, so the rows after it were drawn over it. A hidden Text with the same words, font and width measures it.
export component SelText inherits Rectangle {
    in property <string> text;
    in property <length> size: 14px;
    in property <color> fg: Theme.on-surface;
    in property <bool> mono: false;
    // Break anywhere (code, paths) rather than between words.
    in property <bool> chars: false;
    // Takes the keyboard focus (so Ctrl+A / Ctrl+C go to the text).
    public function grab() { ti.focus(); }
    preferred-width: measure.preferred-width;
    height: measure.preferred-height;
    measure := Text { width: parent.width; text: root.text; wrap: root.chars ? TextWrap.char-wrap : TextWrap.word-wrap; font-size: root.size; font-family: root.mono ? Theme.mono : ""; line-height-factor: 1.4; opacity: 0; }
    ti := TextInput { width: parent.width; height: parent.height; text: root.text; read-only: true; single-line: false; wrap: root.chars ? TextWrap.char-wrap : TextWrap.word-wrap; font-size: root.size; font-family: root.mono ? Theme.mono : ""; line-height-factor: 1.4; color: root.fg; selection-background-color: Theme.primary.with-alpha(0.4); }
}

// Wrapped text whose height follows its wrapping at the width it is given: a plain wrapping Text in a layout is measured before the
// width is known, so a card sized from the layout was shorter than what it held and the rows after it came out below the card.
export component WText inherits Rectangle {
    in property <string> text;
    in property <length> size: 14px;
    in property <color> fg: Theme.on-surface;
    in property <int> weight: 400;
    in property <bool> mono: false;
    // Takes no room (a row that is there but not shown).
    in property <bool> hidden: false;
    height: root.hidden ? 0px : measure.preferred-height;
    visible: !root.hidden;
    measure := Text { width: parent.width; text: root.text; wrap: word-wrap; font-size: root.size; font-weight: root.weight; color: root.fg; font-family: root.mono ? Theme.mono : ""; }
}

// ---- the Stitch pieces every page is made of ----

// A small mono section label ("ACTIVE SESSIONS", "EXPLORER").
export component Label inherits Text {
    color: Theme.outline;
    font-family: Theme.mono;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1.2px;
}

// A filled rectangular badge ("성공", "ENFORCED", "Active"). tone: ok, warn, err, info, neutral, primary.
export component Badge inherits Rectangle {
    in property <string> text;
    in property <string> tone: "neutral";
    in property <bool> mono: true;
    height: 20px;
    width: lbl.preferred-width + 16px;
    border-radius: 4px;
    background: root.tone == "ok" ? Theme.ok.with-alpha(0.14) : root.tone == "warn" ? Theme.warn.with-alpha(0.16) : root.tone == "err" ? Theme.error.with-alpha(0.16) : root.tone == "info" ? Theme.info.with-alpha(0.14) : root.tone == "primary" ? Theme.primary.with-alpha(0.16) : Theme.high;
    lbl := Text {
        x: 8px; y: (parent.height - self.preferred-height) / 2;
        text: root.text; font-size: 11px; font-weight: 600; font-family: root.mono ? Theme.mono : "";
        color: root.tone == "ok" ? Theme.ok : root.tone == "warn" ? Theme.warn-soft : root.tone == "err" ? Theme.error : root.tone == "info" ? Theme.info : root.tone == "primary" ? Theme.primary-soft : Theme.on-var;
    }
}

// A key cap: "Esc", "Enter", "⌥1".
export component KeyHint inherits Rectangle {
    in property <string> text;
    in property <color> fg: Theme.on-var;
    in property <color> fill: Theme.high;
    height: 20px;
    width: max(22px, lbl.preferred-width + 12px);
    border-radius: 4px;
    background: root.fill;
    lbl := Text { x: (parent.width - self.preferred-width) / 2; y: (parent.height - self.preferred-height) / 2; text: root.text; color: root.fg; font-size: 11px; font-family: Theme.mono; font-weight: 600; }
}

// An on/off switch (36x20, primary when on). The page decides what a click does.
export component Toggle inherits Rectangle {
    in property <bool> checked;
    in property <bool> enabled: true;
    callback toggled(bool);
    width: 36px;
    height: 20px;
    border-radius: 10px;
    background: root.checked ? Theme.primary : Theme.highest;
    opacity: root.enabled ? 1 : 0.45;
    Rectangle {
        y: 2px; width: 16px; height: 16px; border-radius: 8px;
        x: root.checked ? parent.width - self.width - 2px : 2px;
        background: root.checked ? Theme.on-primary : Theme.on-var;
        animate x { duration: 120ms; }
    }
    area := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { root.toggled(!root.checked); } }
}

// A segmented choice: the chosen item is raised. `items` are the names; `current` the chosen index.
export component SegTabs inherits Rectangle {
    in property <[string]> items;
    in property <int> current;
    callback chosen(int);
    height: 32px;
    border-radius: 8px;
    background: Theme.lowest;
    border-width: 1px;
    border-color: Theme.hairline;
    HorizontalLayout {
        padding: 2px; spacing: 2px;
        for item[i] in root.items: Rectangle {
            horizontal-stretch: 1;
            border-radius: 6px;
            background: i == root.current ? Theme.high : (ta.has-hover ? Theme.high.with-alpha(0.5) : transparent);
            Text { text: item; color: i == root.current ? Theme.on-surface : Theme.on-var; font-size: 13px; font-weight: i == root.current ? 600 : 400; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
            ta := TouchArea { mouse-cursor: pointer; clicked => { root.chosen(i); } }
        }
    }
}

// A thin icon-only button.
export component IconBtn inherits Rectangle {
    in property <image> icon;
    in property <color> tint: Theme.on-var;
    callback clicked;
    width: 28px;
    height: 28px;
    border-radius: 6px;
    background: ta.has-hover ? Theme.high : transparent;
    Image { source: root.icon; width: 14px; height: 14px; x: 7px; y: 7px; colorize: root.tint; }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// A bar that shows a fraction (0..1).
export component ProgressBar inherits Rectangle {
    in property <float> frac;
    in property <color> tone: Theme.primary;
    height: 6px;
    border-radius: 3px;
    background: Theme.highest;
    Rectangle { x: 0px; width: parent.width * clamp(root.frac, 0, 1); height: parent.height; border-radius: 3px; background: root.tone; }
}

// The sentence a page shows where there is nothing to list (and why).
export component EmptyState inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> show-icon: false;
    height: col.preferred-height + 32px;
    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.hairline;
    background: Theme.low.with-alpha(0.5);
    col := VerticalLayout {
        padding: 16px; spacing: 8px; alignment: center;
        if root.show-icon: Image { source: root.icon; width: 20px; height: 20px; colorize: Theme.outline; }
        WText { text: root.text; size: 12px; fg: Theme.outline; }
    }
}
