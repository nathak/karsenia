// The import panel: earlier sessions of the `claude` command line program, to bring in as chats (src/view/import.rs makes the rows;
// src/bin/desktop/import.rs scans the folder and answers the callbacks).
import { LineEdit, ComboBox, ScrollView } from "std-widgets.slint";
import { Theme, T, Pill, Btn, WText } from "base.slint";
import { Acct } from "panels.slint";

export struct ImpRow { id: string, title: string, folder: string, branch: string, when: string, blocked: string, blocked-text: string, recent: bool }

export global Imp {
    in-out property <bool> open;
    in property <bool> busy;
    in property <string> note;
    in property <[ImpRow]> rows;
    in-out property <string> filter;
    // The account whose sessions are listed: an index into the names the new-chat page shows.
    in-out property <int> acct;
    callback scan(int, string);
    callback filter-edited(string);
    callback pick(string);
}

export component ImportPanel inherits Rectangle {
    background: Theme.surface;
    TouchArea { }
    VerticalLayout {
        padding-left: max(24px, (parent.width - 760px) / 2); padding-right: max(24px, (parent.width - 760px) / 2); padding-top: 32px; padding-bottom: 20px; spacing: 8px;
        Text { text: T.tr("imp_title"); font-size: 24px; font-weight: 600; color: Theme.on-surface; }
        WText { text: T.tr("imp_intro"); size: 13px; fg: Theme.on-var; }
        HorizontalLayout {
            spacing: 8px;
            LineEdit { horizontal-stretch: 1; text <=> Imp.filter; placeholder-text: T.tr("imp_filter_ph"); font-size: 14px; edited(text) => { Imp.filter-edited(text); } }
            if Acct.names.length > 1: ComboBox { width: 180px; model: Acct.names; current-index <=> Imp.acct; selected => { Imp.scan(Imp.acct, Acct.names[Imp.acct]); } }
        }
        if Imp.note != "": WText { text: Imp.note; fg: Theme.primary-soft; size: 12px; }
        if Imp.busy: Text { text: T.tr("imp_scanning"); color: Theme.outline; font-size: 13px; }
        if !Imp.busy && Imp.rows.length == 0: Text { text: Imp.filter == "" ? T.tr("imp_empty") : T.tr("imp_no_match"); color: Theme.outline; font-size: 13px; }
        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                alignment: start; spacing: 6px;
                for r in Imp.rows: Rectangle {
                    height: 66px; border-radius: 8px; border-width: 1px; border-color: Theme.hairline;
                    background: ta.has-hover && r.blocked == "" ? Theme.high : Theme.low;
                    HorizontalLayout {
                        padding: 10px; spacing: 10px;
                        VerticalLayout {
                            horizontal-stretch: 1; spacing: 2px;
                            Text { text: r.title; font-size: 14px; font-weight: 600; color: r.blocked == "" ? Theme.on-surface : Theme.outline; overflow: elide; }
                            Text { text: r.folder; font-size: 11px; font-family: Theme.mono; color: Theme.on-var; overflow: elide; }
                            Text { text: (r.branch != "" ? r.branch + " · " : "") + r.when; font-size: 11px; color: Theme.outline; overflow: elide; }
                        }
                        VerticalLayout {
                            alignment: center; spacing: 4px;
                            if r.blocked != "": Text { text: r.blocked-text; font-size: 11px; color: Theme.outline; horizontal-alignment: right; }
                            if r.blocked == "" && r.recent: Text { text: T.tr("imp_recent"); font-size: 11px; color: Theme.primary-soft; horizontal-alignment: right; }
                            if r.blocked == "": Text { text: T.tr("imp_pick"); font-size: 12px; font-weight: 600; color: Theme.primary; horizontal-alignment: right; }
                        }
                    }
                    ta := TouchArea { enabled: r.blocked == ""; mouse-cursor: r.blocked == "" ? pointer : default; clicked => { Imp.pick(r.id); } }
                }
            }
        }
        HorizontalLayout { alignment: end; Btn { text: T.tr("imp_close"); clicked => { Imp.open = false; } } }
    }
}
